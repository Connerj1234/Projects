OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
# off = no API calls, daily = short daily note, weekly = note only on BRIEF_AI_WEEKDAY
BRIEF_AI_MODE=daily
BRIEF_AI_WEEKDAY=6
BRIEF_COMPARE_MODELS=gpt-5.4-nano

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

BRIEF_TIMEZONE=America/New_York
BRIEF_LOOKAHEAD_DAYS=7
BRIEF_OUTPUT_DIR=./out
# Public or private base URL where the generated out/ directory is served.
BRIEF_BASE_URL=

